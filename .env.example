# Servidor HTTP e bancos
PORT=4173
OPENCIRCUIT_DB=data/opencircuit.sqlite
# Pode apontar para o mesmo arquivo acima; as migrations são isoladas por recurso.
OPENCIRCUIT_LIBRARY_DB=data/library.sqlite

# Use um segredo aleatório com pelo menos 32 caracteres em produção.
OPENCIRCUIT_SESSION_SECRET=
# Alternativa: arquivo persistente com o segredo. O padrão fica ao lado do banco.
OPENCIRCUIT_SESSION_SECRET_FILE=

# Sessão anônima assinada (padrão) ou identidade entregue por proxy autenticador.
OPENCIRCUIT_IDENTITY_MODE=session
# Somente para trusted-proxy. O proxy deve remover qualquer valor enviado pelo cliente.
OPENCIRCUIT_AUTH_HEADER=x-authenticated-user

# Ative quando a aplicação for servida exclusivamente por HTTPS.
OPENCIRCUIT_SECURE_COOKIE=0
