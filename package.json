{
  "name": "opencircuit-logic-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "audit": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "dev": "vite",
    "start": "node server/index.mjs",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "profile": "node scripts/run-profile.mjs",
    "preview": "vite preview",
    "lint": "eslint eslint.config.js 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx,mjs}' 'server/**/*.mjs' 'scripts/**/*.{ts,tsx,mjs}' vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.server.json",
    "format": "prettier --write . --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "check": "npm run audit:prod && npm run audit && npm run format:check && npm run lint && npm run coverage && npm run build"
  },
  "dependencies": {
    "immer": "^11.1.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "use-immer": "^0.11.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
